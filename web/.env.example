# URL pública da API (vai para o navegador; não coloque segredos aqui).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Somente no servidor (Vercel): protegem o disparo diário da automação.
CRON_SECRET=
AUTOMATION_SECRET=
# "false" esconde o botão "Rodar agora" (em produção o cron dispara).
NEXT_PUBLIC_ENABLE_MANUAL_AUTOMATION=true
